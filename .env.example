# AETHERIA LUXURY E-BOOKS — ENVIRONMENT CONFIGURATION
# Copy to .env and insert your real credentials when going into production.

PORT=3001
VITE_API_BASE=http://localhost:3001

# Razorpay Credentials (from https://dashboard.razorpay.com/#/app/keys)
# Keep in test mode (rzp_test_...) until merchant KYC and production test pass.
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Webhook Secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=aetheria_webhook_secret_2026

# Cryptographic token signing secret for expiring PDF download links
DOWNLOAD_TOKEN_SECRET=aetheria_luxury_download_secret_key_9981
